[Unit]
Description=Portfolio Instagram sync (fetch + rebuild)

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Codes/portfolio
# The sync script also auto-loads ~/.config/portfolio/instagram.env itself;
# this makes the credentials visible to the process environment as well.
EnvironmentFile=%h/.config/portfolio/instagram.env
ExecStart=/usr/bin/fish %h/Documents/Codes/portfolio/scripts/sync-instagram.fish
